 54:CLK_OUT = CLK_IN;
 55:
 56:/*  Registered logic for Clock Divider ~1.625MHz 50% of the duty cycle */
 57:CLK_DIV2.D = !CLK_DIV2;
 58:
 59:/*  Output enables
 60:    This to take the Outputs from their default Tristate */
 61:CLK_DIV2.OE = 'b'1;
 62:BDIR.OE = 'b'1;
 63:BC1.OE = 'b'1;
 64:CLK_OUT.OE = 'b'1;
 65:

[0016cb] Please note: no expression assigned to:  CLK_DIV2.ar
