  1:Name ZXEightyZON; 
  2:PartNo GAL22V10C; 
  3:Date 22/10/2025; 
  4:Revision 1.3; 
  5:Designer Bambleweeny57; 
  6:Company Submeson Brain Corporation; 
  7:Assembly ZXEightyZON; 
  8:Location U2; 
  9:Device g22v10;
 10:
 11:/* Inputs */ 
 12:PIN 1 = CLK_IN;         /* 3.25MHz Clock from ZX81 - Used as global Clock */ 
 13:PIN 2 = A0; 
 14:PIN 3 = A1; 
 15:PIN 4 = A2; 
 16:PIN 5 = A3; 
 17:PIN 6 = A4;             /* Present, ignored in decode to make compatable with all decode addresses */ 
 18:PIN 7 = A5;             /* Present, ignored in decode */ 
 19:PIN 8 = A6;             /* Present, ignored in decode */ 
 20:PIN 9 = A7;             /* A7: Latch=1 vs Write=0 */ 
 21:PIN 10 = !WR_N;         /* Active Low Write Name "WR" is true when pin is Low */ 
 22:PIN 11 = !IORQ_N;       /* Active Low I/O Name "IORQ" is true when pin is Low */
 23:PIN 13 = RD_N;          /* Present, ignored in decode */ 
 24:
 25:/* Outputs */ 
 26:PIN 14 = BDIR;          /* YM2149 Pin 27 (Active High) */ 
 27:PIN 15 = BC1;           /* YM2149 Pin 29 (Active High) */ 
 28:PIN 16 = CLK_DIV2;      /* ~1.625MHz Clock */ 
 29:PIN 17 = CLK_OUT;       /* 3.25MHz Pass through */
 30:
 31:/* Logic Equations */
 32:
 33:/* Decoding: True when IORQ and WR are Low and A0 to A3 are High */ 
 34:VALID_IO = IORQ_N & WR_N & A0 & A1 & A2 & A3;
 35:
 36:/* YM2149 Bus Control (BDIR/BC1 are Active High) */ 
 37:BDIR = VALID_IO; 
 38:BC1 = VALID_IO & A7;
 39:
 40:/* Clock logic: Pass through from Pin 1 */ 
 41:CLK_OUT = CLK_IN;
 42:
 43:/* Registered logic for Clock Divider */ 
 44:CLK_DIV2.D = !CLK_DIV2; /* No explicit .CLK is needed for Pin 1 on a 22V10, but good for clarity */
 45:
 46:/* Mandatory for GAL22V10: Enable the output buffers */ 
 47:/* This ensures the pins are not in a High-Z state */ 
 48:[BDIR, BC1, CLK_DIV2, CLK_OUT].OE = 'b'1;
 49:

[0016cb] Please note: no expression assigned to:  CLK_DIV2.ar
[0016cb] Please note: no expression assigned to:  CLK_DIV2.sp


