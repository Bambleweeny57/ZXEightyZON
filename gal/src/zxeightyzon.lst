  1:Name ZXEightyZON; 
  2:PartNo GAL22V10D; 
  3:Date 04/01/2026; 
  4:Revision 1.0; 
  5:Designer Bambleweeny57; 
  6:Company Submeson Brain Corporation; 
  7:Assembly ZXEightyZON; 
  8:Location U2; 
  9:Device g22v10;
 10:
 11:/* 
 12:    This CUPL is designed to be compatible with the origional ZON X 81 
 13:    and the ZX Spectrum compatible ZON X
 14:
 15:    Variant Name                Latch Address   Data Address
 16:    Modified ZON-X              0xDF            0x0F
 17:    Original ZON-X              0xCF            0x1F
 18:    Manual Variant              0xCF            0x0F
 19:    Additional Combination  0xDF                0x1F
 20:*/
 21:
 22:/*  Inputs */ 
 23:PIN 1 = CLK_IN;         /* 3.25MHz Clock from ZX81 - Used as global Clock */ 
 24:PIN 2 = A0;             /* A0 to A3 where the default ZON X 81 and ZON X address range */
 25:PIN 3 = A1; 
 26:PIN 4 = A2; 
 27:PIN 5 = A3; 
 28:PIN 6 = A4;             /* Present, ignored in decode to make compatible with all ZON addresses */ 
 29:PIN 7 = A5;             /* Present, ignored in decode. Added for future options */ 
 30:PIN 8 = A6;             /* Present, ignored in decode. Added for future options */ 
 31:PIN 9 = A7;             /* A7: Latch=1 vs Write=0 */ 
 32:PIN 10 = !WR_N;         /* Active Low Write Name "WR_N" is true when pin is Low */ 
 33:PIN 11 = !IORQ_N;       /* Active Low I/O Name "IORQ_N" is true when pin is Low */
 34:PIN 13 = !RD_N;         /* Present, ignored in decode. Added for future options */ 
 35:
 36:/*  Outputs */ 
 37:PIN 14 = BDIR;          /* YM2149 or AY-3-8910 Pin 27 (Active High) */ 
 38:PIN 15 = BC1;           /* YM2149 or AY-3-8910 Pin 29 (Active High) */ 
 39:PIN 16 = CLK_DIV2;      /* ~1.625MHz Clock for YM2149 or AY-3-8910 */ 
 40:PIN 17 = CLK_OUT;       /* ~3.25MHz Pass through for YM2149 with /SEL option to allow the VMC clock divider */
 41:
 42:/*  Logic Equations */
 43:
 44:/*  Decoding: True when IORQ and WR are Low and A0 to A3 are High
 45:    Ignoring A4 allows for ZON X and ZON X 81 address decoding
 46:    ZON X was A4 high to make it compatible with theh ZX Spectrum and Interface 1. ZON X 81 was A4 low */ 
 47:VALID_IO = IORQ_N & WR_N & A0 & A1 & A2 & A3;
 48:
 49:/*  YM2149 or AY-3-8910 Bus Control (BDIR/BC1 are Active High) */ 
 50:BDIR = VALID_IO;
 51:BC1  = VALID_IO & A7;
 52:
 53:/*  Clock logic: Pass through from Pin 1 for ~3.25MHz Pass through */ 

LISTING FOR LOGIC DESCRIPTION FILE: zxeightyzon.pld                  Page 2

