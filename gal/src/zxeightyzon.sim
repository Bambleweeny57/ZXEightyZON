%SIGNAL
PIN   2 =  A0 
PIN   3 =  A1 
PIN   4 =  A2 
PIN   5 =  A3 
PIN   6 =  A4 
PIN   7 =  A5 
PIN   8 =  A6 
PIN   9 =  A7 
PIN  15 =  BC1 
PIN  14 =  BDIR 
PIN  16 =  CLK_DIV2 
PIN   1 =  CLK_IN 
PIN  17 =  CLK_OUT 
PIN  11 = !IORQ_N 
PIN  13 = !RD_N 
PIN  10 = !WR_N 
%END

%FIELD
%END

%EQUATION
BC1 =>
    A0 & A1 & A2 & A3 & A7 & !IORQ_N & !WR_N

BC1.oe  =>
    1 

BDIR =>
    A0 & A1 & A2 & A3 & !IORQ_N & !WR_N

BDIR.oe  =>
    1 

CLK_DIV2.d  =>
    CLK_DIV2

CLK_DIV2.oe  =>
    1 

CLK_OUT =>
    CLK_IN

CLK_OUT.oe  =>
    1 

VALID_IO =>
    A0 & A1 & A2 & A3 & IORQ_N & WR_N

%END
