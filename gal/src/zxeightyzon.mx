Name ZXEightyZON; 
PartNo GAL22V10D; 
Date 04/01/2026; 
Revision 1.0; 
Designer Bambleweeny57; 
Company Submeson Brain Corporation; 
Assembly ZXEightyZON; 
Location U2; 
Device g22v10;

/* 
    This CUPL is designed to be compatible with the origional ZON X 81 
    and the ZX Spectrum compatible ZON X

    Variant Name	        Latch Address   Data Address
    Modified ZON-X	        0xDF	        0x0F
    Original ZON-X	        0xCF	        0x1F
    Manual Variant	        0xCF	        0x0F
    Additional Combination  0xDF	        0x1F
*/

/*  Inputs */ 
PIN 1 = CLK_IN;         /* 3.25MHz Clock from ZX81 - Used as global Clock */ 
PIN 2 = A0;             /* A0 to A3 where the default ZON X 81 and ZON X address range */
PIN 3 = A1; 
PIN 4 = A2; 
PIN 5 = A3; 
PIN 6 = A4;             /* Present, ignored in decode to make compatible with all ZON addresses */ 
PIN 7 = A5;             /* Present, ignored in decode. Added for future options */ 
PIN 8 = A6;             /* Present, ignored in decode. Added for future options */ 
PIN 9 = A7;             /* A7: Latch=1 vs Write=0 */ 
PIN 10 = !WR_N;         /* Active Low Write Name "WR_N" is true when pin is Low */ 
PIN 11 = !IORQ_N;       /* Active Low I/O Name "IORQ_N" is true when pin is Low */
PIN 13 = !RD_N;         /* Present, ignored in decode. Added for future options */ 

/*  Outputs */ 
PIN 14 = BDIR;          /* YM2149 or AY-3-8910 Pin 27 (Active High) */ 
PIN 15 = BC1;           /* YM2149 or AY-3-8910 Pin 29 (Active High) */ 
PIN 16 = CLK_DIV2;      /* ~1.625MHz Clock for YM2149 or AY-3-8910 */ 
PIN 17 = CLK_OUT;       /* ~3.25MHz Pass through for YM2149 with /SEL option to allow the VMC clock divider */

/*  Logic Equations */

/*  Decoding: True when IORQ and WR are Low and A0 to A3 are High
    Ignoring A4 allows for ZON X and ZON X 81 address decoding
    ZON X was A4 high to make it compatible with theh ZX Spectrum and Interface 1. ZON X 81 was A4 low */ 
VALID_IO = IORQ_N & WR_N & A0 & A1 & A2 & A3;

/*  YM2149 or AY-3-8910 Bus Control (BDIR/BC1 are Active High) */ 
BDIR = VALID_IO;
BC1  = VALID_IO & A7;

/*  Clock logic: Pass through from Pin 1 for ~3.25MHz Pass through */ 
CLK_OUT = CLK_IN;

/*  Registered logic for Clock Divider ~1.625MHz 50% of the duty cycle */
CLK_DIV2.D = !CLK_DIV2;

/*  Output enables
    This to take the Outputs from their default Tristate */
CLK_DIV2.OE = 'b'1;
BDIR.OE = 'b'1;
BC1.OE = 'b'1;
CLK_OUT.OE = 'b'1;